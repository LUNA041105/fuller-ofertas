# Copia este archivo como .env y coloca tu clave real.
# NUNCA subas el archivo .env al repositorio.
#
# La app tambien puede leer la clave desde la pantalla de Ajustes,
# donde se guarda en el almacen seguro del sistema operativo.
OPENAI_API_KEY=
# Modelo de OpenAI con vision a utilizar (configurable).
OPENAI_MODEL=gpt-5.6
# Modelo de edicion de imagenes para adaptar al formato (configurable).
OPENAI_IMAGE_MODEL=gpt-image-2
