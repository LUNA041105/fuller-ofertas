<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron necesita JIT para el motor V8. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Permite memoria ejecutable no firmada (requerido por V8 y por binarios
       empaquetados con PyInstaller que cargan librerias nativas). -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Permite que la app cargue librerias/plugins no firmados por Apple,
       como el sidecar de Python y sus .so/.dylib. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Permite variables de entorno de DYLD (usado por binarios de PyInstaller). -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
